# 프론트엔드 Pi SDK 설정 (true = Pi Testnet Sandbox / false = Pi Mainnet)
VITE_PI_SANDBOX=true
VITE_APP_NAME=Pi-Bridge

# 백엔드 Serverless API 전용 (Pi Developer Portal에서 발급받은 Server API Key)
PI_API_KEY=your_pi_developer_portal_server_api_key_here
PI_WALLET_PRIVATE_SEED=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
